{
    "compilerOptions":{
        "target": "ES2020",
        "lib": ["ES2020", "DOM"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "types": ["cypress", "node"],
        "strict": true,
        "skipLibCheck": true,
        "jsx": "react-jsx",
    },
    
    "include": ["**/*.ts", "**/*.tsx"],
}